# Секретный префикс сайта (вшивается в сборку Next.js)
NEXT_BASE_PATH=/mp-xxxxxxxxxxxxxxxx

# Basic Auth
BASIC_AUTH_USER=pairly
BASIC_AUTH_PASSWORD=change-me-to-a-long-random-password

# Публичный адрес
PUBLIC_URL=https://pairly.space/mp-xxxxxxxxxxxxxxxx/
NEXT_PUBLIC_SITE_URL=https://pairly.space/mp-xxxxxxxxxxxxxxxx/

# Бренд продукта
NEXT_PUBLIC_PRODUCT_NAME=Pairly

# Реквизиты оператора ПДн (NAME/INN/EMAIL — до открытого запуска;
# ADDRESS и RKN_NOTICE можно оставить пустыми — строки не показываются в UI)
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_INN=
NEXT_PUBLIC_OPERATOR_EMAIL=privacy@pairly.space
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_RKN_NOTICE=

# Параметры Pi (для deploy/deploy-pi.sh)
PI_HOST=dima@91.223.89.199
PI_DIR=/home/dima/mr-pushkin-league
